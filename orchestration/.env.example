# Environment template for the Airflow stack (T-11). Copy to `.env` and fill in
# real values ON THE VM. The real `.env` is git-ignored — NEVER commit secrets.
#
#   cp .env.example .env
#
# Generate a Fernet key once:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# --- Host user mapping ---
# Keep 50000 (the image's built-in `airflow` user). The airflow-init service
# overrides the entrypoint, so it does NOT register an arbitrary host UID in the
# container's passwd; a custom UID (e.g. from `id -u`) makes it fail with
# "uid not found". The bind-mounted dirs are group-root + group-writable, so the
# 50000:0 container user can write to them regardless of the host owner.
AIRFLOW_UID=50000

# --- Airflow admin user (created by `docker compose up airflow-init`) ---
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=<CHANGE_ME>

# --- Airflow internals ---
AIRFLOW__CORE__FERNET_KEY=<FERNET_KEY>

# --- GCP ---
# No service-account key file: the VM runs as its attached service account
# (trade-pipeline@…, --scopes cloud-platform), so the google client libraries
# authenticate via the metadata server (Application Default Credentials). Do NOT
# set GOOGLE_APPLICATION_CREDENTIALS — pointing it at a missing file breaks ADC.
GCP_PROJECT=trade-390514
GCP_REGION=us-central1

# --- Ingest API keys (see orchestration/ingest) ---
FRED_API_KEY=<FRED_API_KEY>

# --- Dataflow launch (T-12 DAG: the launch_dataflow task reads these) ---
# Reuses the existing GCS bucket used for the Dataflow runs (see comandos.md).
DATAFLOW_TEMP_LOCATION=gs://trade-dataflow-trade-390514/temp
DATAFLOW_STAGING_LOCATION=gs://trade-dataflow-trade-390514/staging
DATAFLOW_SERVICE_ACCOUNT=trade-pipeline@trade-390514.iam.gserviceaccount.com

# --- Telegram alerts (T-09/T-10) ---
TELEGRAM_BOT_TOKEN=<TELEGRAM_BOT_TOKEN>
TELEGRAM_CHAT_ID=<TELEGRAM_CHAT_ID>

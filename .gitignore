*.py[codz]
*$py.class

# Secrets
# service account keys
*-key.json
*-credentials.json

# Terraform
terraform_infra/.terraform/
terraform_infra/*.tfstate
terraform_infra/*.tfstate.backup
terraform_infra/.terraform.lock.hcl

